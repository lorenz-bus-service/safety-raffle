# Safety raffle settings.
# Copy this file to .env and fill in the values. The .env file is ignored by git: never commit it.
# Every setting except SAMSARA_API_TOKEN has a default, shown here.

# ---------------------------------------------------------------------------
# Samsara
# ---------------------------------------------------------------------------
# An API token with read access to Drivers and to "Safety Events & Scores".
SAMSARA_API_TOKEN=
# Use https://api.eu.samsara.com or https://api.ca.samsara.com for EU or Canadian accounts.
SAMSARA_API_URL=https://api.samsara.com

# ---------------------------------------------------------------------------
# Time zone
# ---------------------------------------------------------------------------
# Decides where each day's midnight falls and which month is "last month".
# US time zones:
#   America/New_York      Eastern
#   America/Chicago       Central
#   America/Denver        Mountain
#   America/Phoenix       Mountain, no daylight saving (most of Arizona)
#   America/Los_Angeles   Pacific
#   America/Anchorage     Alaska
#   Pacific/Honolulu      Hawaii
# Any IANA time zone name works, for example Europe/London.
TIME_ZONE=America/Chicago

# How dates are printed on tickets. en-US prints 10/01/26; en-GB prints 01/10/26.
LOCALE=en-US

# ---------------------------------------------------------------------------
# Ticket rules
# ---------------------------------------------------------------------------
# A driver earns one ticket for each day with a safety score of at least MINIMUM_SCORE
# and MORE THAN MINIMUM_MILES miles driven (exactly MINIMUM_MILES earns nothing).
MINIMUM_SCORE=90
MINIMUM_MILES=20

# Only drivers who are active in Samsara when the job runs earn tickets.
# Samsara stops returning scores for a driver once they are deactivated.

# Drivers who never earn tickets, such as shared placeholder accounts. Comma-separated.
# A driver matching any one rule is excluded. Letter case is ignored.
#   EXCLUDE_USERNAMES=Shop,Training
#   EXCLUDE_TAGS=Mechanics
#   EXCLUDE_ATTRIBUTES=Role=Placeholder,Type=Pool Vehicle
EXCLUDE_USERNAMES=
EXCLUDE_TAGS=
EXCLUDE_ATTRIBUTES=

# Where the employee ID printed on each ticket comes from:
# "username" (the Samsara username) or the name of a Samsara external ID, such as employeeNumber.
EMPLOYEE_ID_SOURCE=username

# ---------------------------------------------------------------------------
# Printing
# ---------------------------------------------------------------------------
# avery-5160   US Letter, 30 labels per sheet, 1" x 2 5/8" (cut apart by hand)
# avery-5371   US Letter, 10 perforated business cards per sheet, 2" x 3 1/2"
# avery-l7160  A4, 21 labels per sheet, 63.5 mm x 38.1 mm
# custom       your own measurements, below
LABEL_LAYOUT=avery-5160

# Only used when LABEL_LAYOUT=custom. Measurements are in LABEL_UNITS (in or mm).
# Margins run from the page edge to the first label; gaps are the space between labels.
#LABEL_UNITS=in
#LABEL_PAGE_WIDTH=8.5
#LABEL_PAGE_HEIGHT=11
#LABEL_MARGIN_TOP=0.5
#LABEL_MARGIN_LEFT=0.1875
#LABEL_COLUMNS=3
#LABEL_ROWS=10
#LABEL_WIDTH=2.625
#LABEL_HEIGHT=1
#LABEL_GAP_X=0.125
#LABEL_GAP_Y=0

# Nudge all printing, in millimetres, if your printer is slightly off.
# Positive X moves right; positive Y moves down. Check with: npm run raffle -- test-page
PRINT_OFFSET_X_MM=0
PRINT_OFFSET_Y_MM=0

# Tickets print sorted by surname, first name, then date.
# To batch them by location first, list Samsara tag names in the order they should print.
# Each tag starts on a new sheet; drivers with none of these tags print last.
#   GROUP_BY_TAGS=North Depot,South Depot
GROUP_BY_TAGS=

# ---------------------------------------------------------------------------
# Re-runs
# ---------------------------------------------------------------------------
# What happens when a period that already has tickets is run again:
#   supplementary  print only tickets not issued before (for example after a score revision)
#   full           print every ticket again
# Override for one run with --full or --supplementary.
RERUN_MODE=supplementary

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Score files, the record of issued tickets, output files and logs are kept here.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# none | smtp | graph | resend      See docs/email.md for setting each one up.
EMAIL_TRANSPORT=none
# The sending address. For graph, this must be the mailbox the app is allowed to send as.
EMAIL_FROM=
# Staff who receive the ticket PDF, the ticket CSV and the summary, and any failure notice. Comma-separated.
ADMIN_EMAILS=

# true: each driver is emailed their own ticket count and qualifying days. Addresses come from Samsara.
SEND_DRIVER_EMAILS=false
# true: the driver email also lists the days that did not earn a ticket.
DRIVER_EMAIL_INCLUDE_NON_QUALIFYING=false

# EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (usually port 587).
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# EMAIL_TRANSPORT=graph  (Microsoft 365)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# EMAIL_TRANSPORT=resend
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Slack and Teams
# ---------------------------------------------------------------------------
# Optional incoming-webhook addresses. Failures are always posted to whichever is set.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# true: a successful run also posts a one-line confirmation, so silence means the job did not run.
NOTIFY_ON_SUCCESS=true
